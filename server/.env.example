PORT=5000
MONGO_URI=mongodb://localhost:27017/local-services-marketplace
# Comma-separated list — Vite picks a different port (3001, 3002...) if 3000 is busy
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Clerk (https://dashboard.clerk.com -> your app -> API Keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: leave unset to skip sending emails (bookings still work, emails are just logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

